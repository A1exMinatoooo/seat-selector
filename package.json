{
  "name": "pick-your-seat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "admin:hash": "tsx scripts/hash-password.ts",
    "local:init": "tsx scripts/local-test.ts init",
    "local:dev": "tsx scripts/local-test.ts dev",
    "local:reset": "tsx scripts/local-test.ts reset",
    "local:stop": "tsx scripts/local-test.ts stop",
    "local:info": "tsx scripts/local-test.ts info",
    "local:credentials": "tsx scripts/local-test.ts credentials",
    "local:exec": "tsx scripts/local-test.ts exec",
    "local:e2e": "tsx scripts/local-test.ts e2e",
    "local:phone": "bash scripts/local-test-phone.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.3",
    "csv-parse": "^6.1.0",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^1.31.0",
    "next": "^16.3.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
